"This B<squid.conf> example defines two Squid acls.  I<usergroup1> matches "
"users in I<group1> , and I<usergroup2> matches users in I<group2> or "
"I<group3>"
msgstr ""

#. type: Plain text
#: src/acl/external/unix_group/ext_unix_group_acl.8:59
